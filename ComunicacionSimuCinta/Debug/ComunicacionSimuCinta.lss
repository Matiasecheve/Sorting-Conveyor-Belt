000016be <__vector_14>:
/*
 * Timer0 CTC — Base de tiempo del sistema.
 * Se dispara cada 2 ms (F_CPU=16MHz, prescaler=256, OCR0A=124).
 * Incrementa tick_ms que usan los módulos de actuadores y debug.
